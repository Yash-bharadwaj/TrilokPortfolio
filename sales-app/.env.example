# ---------------------------------------------------------------------------
# Sai Brundavan Grand — sales app configuration
#
# Copy this file to `.env` and fill in the values from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
# `.env` is git-ignored. Never commit real values.
#
# With these left blank the app still runs, saving data on the device only.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The login screen asks for a username. It is turned into an email address
# using this domain before being sent to Firebase Auth, so the staff never
# have to type one. Must match the user you create in Firebase.
VITE_AUTH_EMAIL_DOMAIN=saibrundavangrand.in

# Firestore document id for this hotel. Leave as is unless a second
# property is added later.
VITE_HOTEL_ID=sai-brundavan-grand

# ---------------------------------------------------------------------------
# On-device mode (no Firebase). Leave BLANK for any build you publish.
# Never put the real Firebase password here: anything in a VITE_ variable is
# compiled into the JavaScript that every visitor downloads.
# ---------------------------------------------------------------------------
VITE_LOCAL_USERNAME=
VITE_LOCAL_PASSWORD=
